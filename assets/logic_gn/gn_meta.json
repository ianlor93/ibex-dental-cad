  "modelgenerator": {
    "tier": 1,
    "tech_type": "FAST",
    "inputs": {
      "IN_GEO_Mesh": {
        "type": "NodeSocketGeometry",
        "is_port": true
      },
      "G1_Profondita_MM": {
        "type": "slider",
        "label": "Profondità base (mm)",
        "hidden": false,
        "readonly": false,
        "min": 5,
        "max": 50,
        "step": 1,
        "default": 15
      },
      "G2_Margine_MM": {
        "type": "slider",
        "label": "Margine base (mm)",
        "min": 0,
        "max": 5,
        "step": 0.5,
        "default": 0
      },
      "G3_Spessore_MM": {
        "type": "slider",
        "label": "Spessore pareti (mm)",
        "min": 2,
        "max": 4,
        "step": 0.1,
        "default": 2.5
      }
    },
    "outputs": {
      "OUT_GEO_Mesh": {
        "type": "NodeSocketGeometry",
        "is_port": true
      }
    },
    "display_name": "Model Generator"
  },
  "burn": {
    "tier": 1,
    "tech_type": "FAST",
    "no_backend": true,
    "inputs": {
      "IN_GEO_Mesh": {
        "type": "NodeSocketGeometry",
        "is_port": true
      }
    },
    "outputs": {},
    "display_name": "Burn",
    "description": "Esporta la mesh post-pipeline come STL nel cloud Nextcloud dell'utente. Trigger esplicito (bottone «Burn»)."
  },
  "meshcleaner": {
    "tier": 1,
    "tech_type": "FAST",
    "inputs": {
