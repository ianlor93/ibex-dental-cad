{
  "transform": {
    "inputs": {
      "IN_GEO_Mesh": {
        "type": "NodeSocketGeometry",
        "is_port": true
      },
      "G1_Trasla_POS": {
        "type": "vector",
        "label": "Traslazione",
        "group": "Traslazione_POS",
        "hidden": false,
        "readonly": false,
        "step": 0.1,
        "default": [
          0,
          0,
          0
        ]
      },
      "G2_Ruota_ROT": {
        "type": "vector",
        "label": "Rotazione",
        "group": "Rotazione_ROT",
        "hidden": false,
        "readonly": false,
        "step": 1,
        "default": [
          0,
          0,
          0
        ]
      }
    },
    "outputs": {
      "OUT_GEO_Mesh": {
        "type": "NodeSocketGeometry",
        "is_port": true
      },
      "OUT_MTX_Transform": {
        "type": "NodeSocketMatrix",
        "is_port": true
      }
    },
    "tech_type": "FAST",
    "display_name": "Trasforma Mesh"
  },
