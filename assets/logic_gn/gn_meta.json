      "G3_Patch_Fori_INT": {
        "type": "slider",
        "label": "Patch Fori",
        "hidden": false,
        "readonly": false,
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 20
      },
      "G4_Patch_in_curvatura": {
        "type": "checkbox",
        "label": "Patch in curvatura",
        "default": false
      }
    },
    "outputs": {
      "OUT_GEO_Mesh": {
        "type": "NodeSocketGeometry",
        "is_port": true
      }
    },
    "display_name": "Pulisci Mesh"
  },
  "slice": {
    "tier": 1,
    "tech_type": "FAST",
    "inputs": {
