# IBEX — variabili d'ambiente per docker-compose.yml.
# Copia questo file in `.env` (accanto a docker-compose.yml) e compila i valori.
# I segreti e le chiavi sono lasciati VUOTI di proposito: non committare mai il `.env`.

# ── Percorsi sull'host ────────────────────────────────────────────────────────
# Dati di IBEX: il compose monta ${IBEX_DATA_DIR}/active.
IBEX_DATA_DIR=
# Cartella dati di Nextcloud (quella che contiene <uid>/files/). IBEX vi legge le mesh
# e vi scrive gli archivi .ibex e i file del burn.
NEXTCLOUD_DATA_DIR=

# ── Utente dei container ──────────────────────────────────────────────────────
# uid:gid con cui girano ibex-app (linuxserver PUID/PGID) e i worker (`user:`).
# Deve poter scrivere in IBEX_DATA_DIR e NEXTCLOUD_DATA_DIR.
PUID=99
PGID=100
TZ=Europe/Rome

# ── Database (solo ibex-app) ──────────────────────────────────────────────────
# IBEX usa solo tabelle di Nextcloud (oc_filecache, oc_storages, oc_mimetypes,
# oc_group_user): l'utente DB ha bisogno solo dei permessi su quelle.
DB_HOST=
DB_NAME=nextcloud
DB_USER=
DB_PASS=

# ── Nextcloud (solo ibex-app) ─────────────────────────────────────────────────
# URL dell'istanza Nextcloud che incornicia IBEX, senza `/` finale
# (es. https://cloud.example.org). Se vuoto: niente CORS, frame-ancestors solo 'self',
# niente postMessage verso la shell, i redirect alla lobby rispondono 500.
NEXTCLOUD_URL=
# PEM della chiave pubblica di External Sites, codificato in base64 su una riga
# (`base64 -w0 chiave.pem`). Se vuota, nessun utente può accedere.
NEXTCLOUD_SSO_PUBKEY_B64=
# Dominio del cookie di sessione (es. .example.org) quando IBEX e Nextcloud sono
# sottodomini dello stesso dominio. Vuoto = cookie solo per l'host di IBEX.
SESSION_DOMAIN=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Host di Redis per ibex-app e worker (default: il servizio ibex-redis del compose).
REDIS_HOST=ibex-redis
# Password di Redis (--requirepass). Obbligatoria: il comando di ibex-redis la usa.
IBEX_REDIS_PASS=

# ── Chiavi di cifratura ───────────────────────────────────────────────────────
# Formato di entrambe: 32 byte casuali codificati in base64 (AES-256-GCM).
# Generale con:  openssl rand -base64 32
# Sono indipendenti: usa due valori diversi.
# Chiave degli archivi .ibex (solo worker). Se la perdi, gli archivi non si aprono più.
IBEX_ARCHIVE_KEY=
# Chiave delle miniature negli archivi (worker + ibex-app).
IBEX_THUMB_KEY=

# Non vanno impostate qui:
#   HOSTNAME — la imposta Docker (nome del container); il worker la usa come ID.
#   HOME     — fissata a /tmp nel compose per i worker.
